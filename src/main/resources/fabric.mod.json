{
    "schemaVersion": 1,
    "id": "origins-legacy-classes",
    "version": "${version}",
    "name": "Origins Legacy: Classes",
    "description": "An add-on for Origins: Legacy which adds classes to the game. Unofficial port of Origins: Classes for modern Minecraft.",
    "authors": [
        "Apace",
        "GGSkyOne"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/origins-legacy-classes",
        "sources": "https://github.com/GGSkyOne/origins-legacy-classes",
        "issues": "https://github.com/GGSkyOne/origins-legacy-classes/issues"
    },
    "license": "MIT",
    "icon": "assets/origins-classes/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.apace100.originsclasses.OriginsClasses"
        ],
        "client": [
            "io.github.apace100.originsclasses.OriginsClassesClient"
        ],
        "appleskin": [
            "io.github.apace100.originsclasses.compat.AppleSkinCompat"
        ]
    },
    "mixins": [
        "origins-classes.mixins.json"
    ],
    "depends": {
        "fabricloader": "*",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*",
        "origins-legacy": ">=1.12.15"
    },
    "breaks": {
        "origins-legacy": ">=2.0.0"
    }
}
